.venv/
__pycache__/
*.pyc
# The training CSV is ~200k rows / 40 MB. Models and metrics are committed
# instead, because those are what the demo machine actually needs.
ml/dataset.csv
# WAL mode creates -wal and -shm sidecars alongside the database. They are
# transient state, the -wal runs to megabytes, and an earlier commit shipped
# both by accident because this pattern only covered the plain file.
data/emission_monitor.db*
*.log

# The Random Forest serialises to ~1 GB at the configured depth and nothing
# loads it. Its metrics live in ml/metrics.json; the model the backend actually
# scores with is xgboost_model.joblib, which is committed.
ml/models/random_forest_model.joblib
